@page "/grocerytest"
@using System.Text.Json
@inject HttpClient Http

<h3>Grocery Store Optimizer</h3>

<div class="container mt-4">
    @if (stores == null)
    {
        <div class="alert alert-warning">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Mapping store layout from Python backend...
        </div>
    }
    else
    {
        <div class="row">
            <div class="alert alert-success">
                Connected! Python Backend responded successfully.
            </div>
        </div>
        <div class="row g-3 card p-4 shadow-sm mb-4">
            <h5>Configure Your Route</h5>
            <div class="row mb-3">
                <div class="col-md-5">
                    <label for="selectedStoreId" class="form-label"><b>Select a Store:</b></label>
                    <select id="selectedStoreId" class="form-control" @bind="selectedStoreId" @bind:after="SelectStore">
                        <option value="">-- Choose an Store --</option>
                        @foreach (StoreDTO store in stores.Stores)
                        {
                            <option value="@store.Id">@store.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-5">
                    <AisleSelection Label="Select Start Aisle" ElementId="selectedStart" Aisles="aisles?.Aisles"
                                    HasStoreSelected="@(selectedStoreId!=null)" IsLoadingAisles="isLoadingAisles"
                                    @bind-Value="selectedStartId" @bind-Value:after="SelectAisles">
                    </AisleSelection>
                </div>
                <div class="col-md-5">
                    <AisleSelection Label="Select End Aisle" ElementId="selectedEnd" Aisles="aisles?.Aisles"
                                    HasStoreSelected="@(selectedStoreId!=null)" IsLoadingAisles="isLoadingAisles"
                                    @bind-Value="selectedEndId" @bind-Value:after="SelectAisles">
                    </AisleSelection>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="CalculateRoute"
                            disabled="@(selectedStartId == null || selectedEndId == null)">
                        Find Route
                    </button>
                </div>
            </div>
        </div>
    }
    @if (isSearching)
    {
        <div class="text-center p-3">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Running Dijkstra's algorithm on the server...</p>
        </div>
    }
    else if (routeData != null)
    {
        <div class="card border-success shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Optimal Route Discovered!</h5>
            </div>
            <div class="card-body">
                <p><strong>Start:</strong> @routeData.StartLocation</p>
                <p><strong>End:</strong> @routeData.EndLocation</p>
                <p><strong>Total Distance:</strong> @routeData.TotalDistanceFeet feet</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(calcRouteError))
    {
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">An Error Occurred!</h5>
            </div>
            <div class="card-body">
                <p><strong>Error: </strong><br />
                    @foreach (string line in calcRouteError.Split('\n'))
                    {
                        <span>@line</span><br />
                    }
                </p>
            </div>
        </div>
    }
</div>

@code {
    private RouteResponse? routeData;
    private AislesResponse? aisles;
    private StoresResponse? stores;

    // UI Binding States
    private int? selectedStartId; // Allow for null if nothing is selected
    private int? selectedEndId; // Allow for null if nothing is selected
    private int? selectedStoreId; // Allow for null if nothing is selected
    private bool isSearching = false;
    private bool isLoadingAisles = false;

    // Error message variables.
    private string? calcRouteError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Call the Python backend from C#.
            // Initial boot setup: Only grab the map nodes so the UI can draw the selections
            stores = await Http.GetFromJsonAsync<StoresResponse>("http://127.0.0.1:8000/api/stores");
        }
        catch (Exception ex)
        {
            // If the server is down, the error can be caught here.
            Console.WriteLine($"Connection failed: {ex.Message}");
        }
    }
    private async Task SelectStore()
    {
        try
        {
            // Turn on loading flag.
            isLoadingAisles = true;

            // Clear out any existing data in the form.
            routeData = null;
            aisles = null;
            selectedStartId = null;
            selectedEndId = null;

            if (selectedStoreId == null)
            {
                return; // No need to set isLoadingAisles = false here, the finally block will run regardless of the early termination.
            }

            // A new store is selected, make a call to the database to get the aisles.
            aisles = await Http.GetFromJsonAsync<AislesResponse>($"http://127.0.0.1:8000/api/stores/{selectedStoreId}/aisles");
            //AislesResponse already has the shape that matches the wrapped shape. No need to use List<AisleDTO>.
        }

        catch (Exception ex)
        {
            Console.WriteLine($"Connection failed: {ex.Message}");
        }

        finally
        {
            isLoadingAisles = false;
        }

    }
    // The function below is only clearing existing data out on the page, no call to the database.
    // This can be a 'void' rather than an 'async Task'.
    private void SelectAisles()
    {
        // Clear out any existing data in the form.
        routeData = null;
        calcRouteError = string.Empty;
    }
    private async Task CalculateRoute()
    {
        if (selectedStartId is null || selectedEndId is null) return;

        try
        {
            isSearching = true;
            routeData = null; //Clear old cards out of the view while calculating.
            calcRouteError = string.Empty;

            // Create a safe, dynamic query string using the variables bound to the dropdowns.
            string apiUrl =
                $"http://127.0.0.1:8000/api/route?start_id={selectedStartId}&end_id={selectedEndId}";

            HttpResponseMessage response = await Http.GetAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            {
                routeData = await response.Content.ReadFromJsonAsync<RouteResponse>();
            }
            else
            {
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    ListErrorResponse? failedIds = await response.Content.ReadFromJsonAsync<ListErrorResponse>();

                    if (failedIds != null)
                    {
                        calcRouteError = string.Join("\n", failedIds.Detail.Select(id => $"Aisle ID {id} does not exist in the database."));
                    }
                    else
                    {
                        calcRouteError = "One or more of the selected Aisles do not exist in the database.";
                    }
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    DictErrorResponse? failedIds = await response.Content.ReadFromJsonAsync<DictErrorResponse>();

                    if (failedIds != null)
                    {
                        calcRouteError = string.Join("\n", failedIds.Detail.Select(kvp => $"Aisle ID {kvp.Key} belongs to store ID {kvp.Value}."));
                        calcRouteError = calcRouteError + "\nStore IDs must match between aisles.";
                    }
                    else
                    {
                        calcRouteError = "One or more of the selected Aisles do not exist for the selected store.";
                    }
                }
                else
                {
                    calcRouteError = "An unknown error has occurred when connecting to the database.";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pathfinding calculation failed: {ex.Message}");
        }
        finally
        {
            isSearching = false;
        }
    }
}