@page "/grocerytest"
@using System.Text.Json
@inject HttpClient Http

<h3>Grocery Store Optimizer</h3>

<div class="container mt-4">
    @if (stores==null)
    {
        <div class = "alert alert-warning">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Mapping store layout from Python backend...
        </div>
    }
    else
    {
        <div class="row">
            <div class="alert alert-success">
                Connected! Python Backend responded successfully.
            </div>
        </div>
        <div class="row g-3 card p-4 shadow-sm mb-4">
            <h5>Configure Your Route</h5>
            <div class="row">
                <div class="col-md-5">
                    <label for="selectedStoreId" class="form-label"><b>Select a Store:</b></label>
                    <select id="selectedStoreId" class="form-control" @bind="selectedStoreId" @bind:after="SelectStore">
                        <option value="">-- Choose an Store --</option>
                        @foreach (StoreDTO store in stores.Stores)
                        {
                            <option value="@store.Id">@store.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <label for="selectedStartId" class="form-label"><b>Select a Starting Aisle:</b></label>
                    <select id="selectedStartId" class="form-control" @bind="selectedStartId" disabled="@(isLoadingAisles ? "disabled" : null)">
                        
                        @if (aisles != null)
                        {
                            <option value="">-- Choose an Aisle --</option>
                            @foreach (AisleDTO aisle in aisles.Aisles)
                            {
                                
                                <option value="@aisle.Id">@aisle.Name</option>
                            }
                        }
                        else
                        {
                            @if (selectedStoreId == null)
                            {
                                <option value="">--Store must be selected first--</option>
                                <option disabled>No Store Selected...</option>
                            }
                            else if (aisles.Aisles is not [] && isLoadingAisles)
                            {
                                <option value="">--No Aisles Available--</option>
                                <option disabled>Aisles Loading...</option>
                            }
                        }

                    </select>
                </div>
                @* <div class="col-md-5">
                    <label for="startLocationId" class="form-label"><b>Select Starting Aisle:</b></label>
                    <select id="startLocationId" class="form-control" @bind="selectedStartId">
                        <option value="">-- Choose an Aisle --</option>
                        @foreach (var location in aisleLocations)
                        {
                            <option value="@location">@location</option>
                        }
                    </select>
                </div> *@

                @* <div class="col-md-5">
                    <label for="endLocationId" class="form-label"><b>Select Ending Aisle:</b></label>
                    <select id="endLocationId" class="form-control" @bind="selectedEndId">
                        <option value="">-- Choose an Aisle --</option>
                        @foreach (var location in aisleLocations)
                        {
                            <option value="@location">@location</option>
                        }
                    </select>
                </div> *@
            </div>
            @* <div class="row">
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100"
                            @onclick="CalculateRoute"
                            disabled="@(string.IsNullOrEmpty(selectedStartId) || string.IsNullOrEmpty(selectedEndId))">
                        Find Route
                    </button>
                </div>
            </div> *@
        </div>
    }
    @if (isSearching)
    {
        <div class="text-center p-3">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Running Dijkstra's algorithm on the server...</p>
        </div>
    }
    else if (routeData != null)
    {
        <div class="card border-success shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Optimal Route Discovered!</h5>
            </div>
            <div class="card-body">
                <p><strong>Start:</strong> @routeData.StartLocation</p>
                <p><strong>End:</strong> @routeData.EndLocation</p>
                <p><strong>Total Distance:</strong> @routeData.TotalDistanceFeet feet</p>
            </div>
        </div>
    }
</div>

@code{
    private RouteResponse? routeData;
    private AislesResponse? aisles;
    private StoresResponse? stores;
    
    // UI Binding States
    private int? selectedStartId; // Allow for null if nothing is selected
    private int? selectedEndId; // Allow for null if nothing is selected
    private int? selectedStoreId; // Allow for null if nothing is selected
    private bool isSearching = false;
    private bool isLoadingAisles = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Call the Python backend from C#.
            //routeData = await Http.GetFromJsonAsync<RouteResponse>("http://127.0.0.1:8000/api/route?start=Home&end=Publix");
            // Initial boot setup: Only grab the map nodes so the UI can draw the selections
            stores = await Http.GetFromJsonAsync<StoresResponse>("http://127.0.0.1:8000/api/stores");
            //aisleLocations = await Http.GetFromJsonAsync<List<string>>("http://127.0.0.1:8000/api/aisles/locations");
        }
        catch (Exception ex)
        {
            // If the server is down, the error can be caught here.
            Console.WriteLine($"Connection failed: {ex.Message}");
        }
    }
    private async Task SelectStore()
    {
        try
        {
            // Turn on loading flag.
            isLoadingAisles = true;
            
            // Clear out any existing data in the form.
            routeData = null;
            aisles = null;
            selectedStartId = null;
            selectedEndId = null;

            if (selectedStoreId == null)
            {
                return; // No need to set isLoadingAisles = false here, the finally block will run regardless of the early termination.
            }

            // A new store is selected, make a call to the database to get the aisles.
            aisles  = await Http.GetFromJsonAsync<AislesResponse>($"http://127.0.0.1:8000/api/stores/{selectedStoreId}/aisles"); // AislesResponse already has the shape that matches the wrapped shape. No need to use List<AisleDTO>.
        }

        catch (Exception ex)
        {
            Console.WriteLine($"Connection failed: {ex.Message}");
        }

        finally
        {
            isLoadingAisles = false;
        }

    }
    private async Task CalculateRoute()
    {
        if (selectedStartId is null || selectedEndId is null) return;

        try
        {
            isSearching = true;
            routeData = null; //Clear old cards out of the view while calculating.

            // Create a safe, dynamic query  string using the variables bound to the dropdowns.
            //string apiUrl = $"http://127.0.0.1:8000/api/route?start={Uri.EscapeDataString(selectedStartId)}&end={Uri.EscapeDataString(selectedEndId)}";
            
            //routeData = await Http.GetFromJsonAsync<RouteResponse>(apiUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Pathfinding calculation failed: {ex.Message}");
        }
        finally
        {
            isSearching = false;
        }
    }
}