<label for="@ElementId" class="form-label"><b>@Label</b></label>
<select id="@ElementId" class="form-control" @bind="Value" @bind:after="OnValueChanged" disabled="@(IsLoadingAisles)">
    
    @if (!IsLoadingAisles)
    {
        if (Aisles != null)
        {
            if(Aisles is [])
            {
                <option value="">--No Aisles Available--</option>
            }
            else
            {
                <option value="">-- Choose an Aisle --</option>
                @foreach (AisleDTO aisle in Aisles)
                {            
                    <option value="@aisle.Id">@aisle.Name</option>
                }
            }
        }
        else
        {
            if (!HasStoreSelected)
            {
                <option value="">--Select Store First--</option>
            }
            else
            {
                <option value="">--Database Connection Error!--</option> 
            }
        }
    }
    else
    {
        <option value ="">--Loading Aisles--</option>
    }

</select>

@code {

    // C# convention is to use pascal case for public properties.
    [Parameter]
    public List<AisleDTO>? Aisles { get; set; } // A null value is needed for the logic check, this does not need to have a new list initialized.

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string ElementId { get; set; } = string.Empty; // ElementId is the label for the <select> tag, thus it needs to be a string. This tag is separate the selectedStartId and selectedEndId HTML IDs.

    [Parameter]
    public bool IsLoadingAisles { get; set; } = false;

    [Parameter]
    public bool HasStoreSelected {get; set;}

    [Parameter]
    public int? Value { get; set; } // Setting type as int because the Ids of the aisles are what needs to be passed back to the parent component.

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; } // Since 'Value' is int? to match the type of the aisle IDs, the type specified in EventCallback<T> must match.

    private async Task OnValueChanged() // ValueChanged is a 'Microsoft.AspNetCore.Components.EventCallback<int?>' object, where bind:after requires a 'System.Action' object to handle the event.
    {
        await ValueChanged.InvokeAsync(Value); // Required to invoke the EventCallback after the event.
    }
    @* [Parameter]
    public RenderFragment? ChildContent {get; set;} *@ // This parameter would be needed if the parent markup contained other HTML content. Since this child is not a fragment, it is not needed.
}